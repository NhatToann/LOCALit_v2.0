# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Red team / security audit artifacts (kept out of repo)
/scripts/redteam-attack.mjs
/scripts/redteam-results.json
/scripts/redteam-*.json


# Claude Code Templates auto-generated lockfile (mirrors installed skills)
/skills-lock.json

# local DB password scratch file
.dbpw

# Debug artifacts
buckets.json
page.html

# Dev server log (left behind by `npm run dev`)
dev-server.log
dev-server-err.log

# Auth cookie scratch files used by probe scripts
auth-cookie-*.txt

# Vercel automation-bypass secret used by E2E browser tests
# (read by scripts/playwright-*.mjs to skip the SSO wall).
/scripts/.vercel-bypass-secret

# Scratch / verification one-off scripts (not part of the codebase)
# Keep them out of the repo per docs/skill.md: "Scratch files
# (check.html, scripts/test-*.mjs, etc.) committed" is banned.
/scripts/list-seed-users.mjs
/scripts/verify-*.mjs
/tmp-*.mjs

# Local Playwright screenshots from one-off probes (kept locally for
# reference, not part of the build artifacts)
/scripts/screenshots/
